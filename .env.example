# Frontend (Vite - exposed to browser)
# Leave empty for local dev (Vite proxies /api → :3001). Use http://localhost:3001 if API runs alone.
VITE_API_URL=
# Google OAuth Web client ID (same value as GOOGLE_CLIENT_ID) — enables "Continue with Google" on signup/login
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Server (Railway service variables — add on the app service, not only Shared Variables)
# Link a Postgres plugin and reference its DATABASE_URL (or DATABASE_PRIVATE_URL).
# FRONTEND_URL must be your public Railway app URL (https://….up.railway.app).
# Local dev: run `npm run db:up` then use this URL (pgvector image in docker-compose.yml)
DATABASE_URL=postgresql://condocorp:condocorp@127.0.0.1:5432/condocorp
OPENAI_API_KEY=sk-your-openai-key
JWT_SECRET=change-me-to-a-random-string
PORT=3001
FRONTEND_URL=http://localhost:5173
RESEND_API_KEY=re_your-resend-key
# Must be a verified sender in Resend (onboarding@resend.dev works for testing)
RESEND_FROM_EMAIL=CondoCorp <you@example.com>
# Google Cloud OAuth 2.0 Web client — authorized JavaScript origins: FRONTEND_URL; no redirect URI needed for ID token flow
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
UPLOAD_DIR=./uploads
# OCR for scanned PDFs and images (Tesseract.js, runs on the server — no extra API key)
# DISABLE_OCR=true
# OCR_MAX_PAGES=75
# OCR_SCALE=1.5
