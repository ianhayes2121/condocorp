# Frontend (Vite - exposed to browser)
# Leave empty for local dev (Vite proxies /api → :3001). Use http://localhost:3001 if API runs alone.
VITE_API_URL=

# Server (Railway service variables — add on the app service, not only Shared Variables)
# Link a Postgres plugin and reference its DATABASE_URL (or DATABASE_PRIVATE_URL).
# FRONTEND_URL must be your public Railway app URL (https://….up.railway.app).
# Local dev: run `npm run db:up` then use this URL (pgvector image in docker-compose.yml)
DATABASE_URL=postgresql://condocorp:condocorp@127.0.0.1:5432/condocorp
OPENAI_API_KEY=sk-your-openai-key
JWT_SECRET=change-me-to-a-random-string
PORT=3001
FRONTEND_URL=http://localhost:5173
UPLOAD_DIR=./uploads
